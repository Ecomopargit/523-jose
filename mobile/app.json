{
  "expo": {
    "name": "ECOMOPAR",
    "slug": "ecomopar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.ecomopar.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "ECOMOPAR",
        "NSCameraUsageDescription": "A ECOMOPAR precisa acessar a câmera para tirar sua foto de perfil.",
        "NSPhotoLibraryUsageDescription": "A ECOMOPAR precisa acessar suas fotos para atualizar sua imagem de perfil.",
        "NSUserNotificationsUsageDescription": "Usamos notificações para lembrar você da contribuição diária.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B3D2C",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "org.ecomopar.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "A ECOMOPAR precisa acessar suas fotos para atualizar sua imagem de perfil.",
          "cameraPermission": "A ECOMOPAR precisa acessar a câmera para tirar sua foto de perfil.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0B3D2C"
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "581d3c92-f5cb-4960-86df-e7c12a6a04da"
      }
    },
    "owner": "lcmonteiro7"
  }
}
